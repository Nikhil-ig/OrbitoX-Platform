# ==============================================================================
# 🪐 OrbitoX Staging VPS Environment Template (infra/docker/.env.example)
# ==============================================================================
# Copy this file to `infra/docker/.env` and populate each required secret.
# Permissions must be restricted: chmod 600 infra/docker/.env
# Never commit `.env` containing production or staging secrets to Git.
# ==============================================================================

# Ingress & Staging Domains
STAGING_DOMAIN=staging.orbitox.io
RESTAURANT_DOMAIN=ros.staging.orbitox.io
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# PostgreSQL Superuser Passwords (Cluster Admin)
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 24
PLATFORM_POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_PLATFORM_POSTGRES_SUPERUSER
ROS_POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_ROS_POSTGRES_SUPERUSER

# ------------------------------------------------------------------------------
# Platform Database Role Passwords (matching vps-enable-roles.sql)
# ------------------------------------------------------------------------------
# Required for DDL migrations under orbitox_migrator:
PLATFORM_MIGRATOR_PASSWORD=CHANGE_ME_PLATFORM_MIGRATOR_PWD
# Operational service role passwords (ingested via psql \getenv):
ORBITOX_RUNTIME_PASSWORD=CHANGE_ME_ORBITOX_RUNTIME_PWD
ORBITOX_MAINTENANCE_PASSWORD=CHANGE_ME_ORBITOX_MAINTENANCE_PWD
ORBITOX_PLATFORM_ADMIN_AUDIT_PASSWORD=CHANGE_ME_ORBITOX_PLATFORM_ADMIN_AUDIT_PWD
HMS_AUDIT_READER_PASSWORD=CHANGE_ME_HMS_AUDIT_READER_PWD
ORBITOX_OUTBOX_RELAY_PASSWORD=CHANGE_ME_ORBITOX_OUTBOX_RELAY_PWD

# ------------------------------------------------------------------------------
# RestaurantOS Database Password (for restaurantos_app)
# ------------------------------------------------------------------------------
ROS_DATABASE_PASSWORD=CHANGE_ME_ROS_DATABASE_PWD

# ------------------------------------------------------------------------------
# Redis Mesh Authentication (Authenticated & Port-Isolated)
# ------------------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_REDIS_STRONG_PASSWORD

# ------------------------------------------------------------------------------
# Platform Cryptographic Application Secrets
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
ORBITOX_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN_HEX32
ORBITOX_RUNTIME_TOKEN=CHANGE_ME_RUNTIME_TOKEN_HEX32
ORBITOX_CONTROL_SECRET=CHANGE_ME_CONTROL_SECRET_HEX32
ORBITOX_GUEST_SECRET=CHANGE_ME_GUEST_SECRET_HEX32
ORBITOX_SERVER_PEPPER=CHANGE_ME_SERVER_PEPPER_HEX32

# Hospital PHI Key Ring (Base64-encoded JSON or AES-256 key)
# Generate with: node -e "console.log(Buffer.from(JSON.stringify({ activeKid: 'k1', keys: { k1: require('crypto').randomBytes(32).toString('base64') } })).toString('base64'))"
ORBITOX_PHI_KEYRING=CHANGE_ME_PHI_KEYRING_BASE64

# RestaurantOS Bridge Token
RESTAURANTOS_PLATFORM_TOKEN=CHANGE_ME_ROS_BRIDGE_TOKEN_HEX32

# Entitlement Grant Signing Keys (Ed25519)
# Optional in staging dev, required in strict production mode.
ORBITOX_GRANT_SIGNING_KEYS=

# ------------------------------------------------------------------------------
# Off-Site Backup Replication (Disaster Recovery Target - Optional)
# ------------------------------------------------------------------------------
# Configures the target destination for scripts/ops/sync-backups-offsite.sh.
# When left unset or blank, backup scripts operate in local-backup-only mode
# and report OFFSITE_NOT_CONFIGURED.
# Supported formats:
#   - S3 / R2 / MinIO: s3://my-encrypted-backup-bucket/orbitox-staging
#   - SSH / Rsync:     backupuser@dr-backup.internal:/var/backups/orbitox
#   - Local Directory: /mnt/secure-dr-volume/orbitox
# Security Requirement:
#   Remote destination targets MUST enforce destination-side encryption at rest
#   (e.g., AWS KMS SSE-KMS, Azure SSE, or LUKS volume encryption).
REMOTE_BACKUP_TARGET=
