  },
  {
    "name": "DataTable ({ DataTable } + @tanstack/react-table)",
    "path": "dist/esm/index.js",
    "import": "{ DataTable }",
    "ignore": ["react", "react-dom"],
    "limit": "75 KB"
  },
  {
    "name": "Form ({ Form } + react-hook-form + zod)",
    "path": "dist/esm/index.js",
