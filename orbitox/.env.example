# OrbitoX environment template. Copy to .env; never commit .env files.
# Generate random secrets with: openssl rand -hex 32
# Generate AES keys with: openssl rand -base64 32

NODE_ENV=development
PORT=3005
LOG_LEVEL=info
ORBITOX_DATA_DIR=./.orbitox-data

# Core secrets. Required in production.
# Automation only; people sign in with operator accounts. Each scope is METHOD:/path.
# Unconfigured scopes deny every route. Example: GET:/api/v1/overview,POST:/api/v1/admin/telemetry
ORBITOX_ADMIN_TOKEN=
ORBITOX_ADMIN_TOKEN_SCOPES=
ORBITOX_RUNTIME_TOKEN=
ORBITOX_CONTROL_SECRET=
ORBITOX_GUEST_SECRET=
ORBITOX_SERVER_PEPPER=
# Base64-encoded 32-byte AES-256-GCM keys.
ORBITOX_MFA_ENCRYPTION_KEY=
ORBITOX_ACCOUNT_TOKEN_ENCRYPTION_KEY=
ORBITOX_BREACHED_PASSWORD_API=on
# Canonical HTTPS origin for verification, reset, and invitation links.
ORBITOX_PUBLIC_BASE_URL=

# RS256 keys used by other platform token flows (PEM, newlines escaped as \n).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Development only. Ignored in production.
ALLOW_UNAUTHENTICATED_DEV_MODE=false

# Client runtime
ORBITOX_BACKEND_URL=http://localhost:3005
ORBITOX_LICENSE_KEY=
ORBITOX_DOMAIN=localhost

# Database / infrastructure
POSTGRES_USER=orbitox
POSTGRES_PASSWORD=
POSTGRES_DB=orbitox
DATABASE_URL=
APP_DATABASE_URL=
PLATFORM_AUDIT_DATABASE_URL=
MAINTENANCE_DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=

# Optional integrations
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
RAZORPAY_KEY_ID=
RAZORPAY_WEBHOOK_SECRET=
