# ===========================================
# OrbitoX Platform — Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env.local to version control.
# Rule D1: Secrets must NEVER be in code or committed env files.
# ===========================================

# --- Application ---
NODE_ENV=
PORT=

# --- Database (PostgreSQL) ---
DATABASE_URL=
TEST_DATABASE_URL=

# --- Redis ---
REDIS_URL=

# --- Authentication ---
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_EXPIRY=
REFRESH_TOKEN_EXPIRY=

# --- Secrets Provider ---
SECRETS_PROVIDER=          # 'env' | 'aws-kms' | 'vault'
AWS_KMS_KEY_ID=
VAULT_ADDR=
VAULT_TOKEN=

# --- Encryption ---
ENCRYPTION_KEY=            # AES-256 key (base64 encoded)

# --- Storage (S3-compatible) ---
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# --- Notifications ---
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# --- AI ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# --- Feature Flags ---
FEATURE_FLAG_PROVIDER=     # 'config' | 'launchdarkly' | 'unleash'
