# ─────────────────────────────────────────────────────────────────────────────
# OrbitoX - environment template.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Generate every secret with:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3005
LOG_LEVEL=info

# Where the control plane keeps its state (projects, keys, audit log).
# Point this at a persistent volume in production.
ORBITOX_DATA_DIR=./.orbitox-data

# Demo projects are seeded in development only. Force on/off with true/false.
# ORBITOX_SEED_DEMO=false

# ── Core secrets (required in production; there are no safe defaults) ────────
# Protects the admin UI and management APIs. Browser login: any username, this as the password.
# API: `Authorization: Bearer <token>`. Leave empty only for local development.
ORBITOX_ADMIN_TOKEN=
# Shared secret your apps (runtimes) use to register and send heartbeats. Pass it to the SDK as `apiKey`.
ORBITOX_RUNTIME_TOKEN=
# Signs control-plane configs and commands sent to client runtimes.
ORBITOX_CONTROL_SECRET=
# Signs guest / QR access tokens.
ORBITOX_GUEST_SECRET=
# RS256 key pair for user JWTs (PEM, newlines as \n).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Client runtime (used by apps that connect TO the control plane) ──────────
ORBITOX_BACKEND_URL=http://localhost:3005
ORBITOX_LICENSE_KEY=
ORBITOX_DOMAIN=localhost

# ── Optional infrastructure (only when running the "db" / "cache" profiles) ──
POSTGRES_USER=orbitox
POSTGRES_PASSWORD=
POSTGRES_DB=orbitox
DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=

# ── Optional integrations ────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
RAZORPAY_KEY_ID=

# ── Planned integrations (documented design; NOT read by the code yet) ───────
# JWT_EXPIRY=
# REFRESH_TOKEN_EXPIRY=
# SECRETS_PROVIDER=env          # env | aws-kms | vault
# ENCRYPTION_KEY=               # AES-256 key, base64
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SENDGRID_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
