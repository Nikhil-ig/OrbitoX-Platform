{
  "name": "orbitox",
  "version": "0.0.0",
  "private": true,
  "description": "OrbitoX Platform OS \u2014 A plugin-driven SaaS operating system",
  "scripts": {
    "bootstrap": "pnpm install && turbo run build --filter=web^...",
    "init:env": "node scripts/init-env.mjs",
    "check:env": "node scripts/check-production-env.mjs",
    "dev:web": "pnpm --filter web dev",
    "smoke": "node scripts/smoke-control-plane.mjs",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:celebrations": "pnpm --filter celebrations dev",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean",
    "migrate": "turbo run migrate",
    "seed": "turbo run seed",
    "doctor": "turbo run doctor",
    "maintain:rate-limit-partitions": "tsx scripts/maintain-rate-limit-partitions.ts",
    "keygen": "node tools/cli/dist/bin.js keygen",
    "package:plugins": "turbo run build && node tools/cli/dist/bin.js package crm",
    "verify:plugins": "node tools/cli/dist/bin.js verify crm",
    "switch:standalone": "node scripts/cliSwitch.js --target=standalone",
    "switch:cluster": "node scripts/cliSwitch.js --target=distributed",
    "snapshot:export": "node scripts/cliSwitch.js --export-snapshot",
    "snapshot:status": "node scripts/cliSwitch.js --status",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@prisma/client": "^6.19.0",
    "prettier": "^3.5.0",
    "prisma": "^6.19.0",
    "tsx": "^4.19.3",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "typescript": "~5.9.3"
    }
  }
}