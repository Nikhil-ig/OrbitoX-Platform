{
  "name": "@orbitox/crm",
  "version": "1.0.0",
  "description": "Headless CRM domain core package providing UI-agnostic business actions, state machines, and hooks.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OrbitoX-io/OrbitoX-Platform.git",
    "directory": "plugins/crm"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.js",
      "default": "./dist/react/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist",
    "test": "jest --passWithNoTests"
  },

  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@orbitox/jest-config": "workspace:*",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "react": "^19.0.0",
    "typescript": "^5.0.0"
  }
}
