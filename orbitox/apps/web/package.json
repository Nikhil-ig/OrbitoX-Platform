{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "../../node_modules/.bin/tsx --test test/api-route-auth-structure.test.ts && node scripts/build-next-with-temporary-pepper.mjs && node scripts/patch-standalone-startup.mjs",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate --schema ../../prisma/schema.prisma",
    "test": "pnpm run prisma:generate && tsx --test test/**/*.test.ts",
    "test:integration": "pnpm run prisma:generate && tsx scripts/test-platform-step1-db.ts",
    "test:database-outage": "pnpm run prisma:generate && tsx scripts/test-platform-db-outage.ts",
    "start": "node ../../scripts/check-production-env.mjs && next start -p 3005",
    "lint": "next lint"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "next": "^15.5.25",
    "@orbitox/ui": "workspace:*",
    "@orbitox/sdk": "workspace:*",
    "@orbitox/types": "workspace:*",
    "@orbitox/runtime": "workspace:*",
    "@orbitox/plugin-engine": "workspace:*",
    "@orbitox-io/plugin-engine": "workspace:*",
    "@orbitox/crm": "workspace:*",
    "@orbitox/core": "workspace:*",
    "@orbitox/commerce": "workspace:*",
    "@orbitox/school": "workspace:*",
    "@orbitox/pos": "workspace:*",
    "@orbitox/external-project-engine": "workspace:*",
    "@orbitox/external-runtime-sdk": "workspace:*",
    "@prisma/client": "^6.19.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5",
    "@orbitox/eslint-config": "workspace:*",
    "@orbitox/tsconfig": "workspace:*"
  }
}
