      "permissions": {
        "create": "restaurant.menu_item.create",
        "read": "restaurant.menu_item.read",
        "update": "restaurant.menu_item.update",
        "delete": "restaurant.menu_item.delete"
      },
      "ui": {
        "defaultView": "table"
      }
    }
  ]
