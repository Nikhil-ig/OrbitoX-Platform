model PlatformApiKey {
  id                  String             @id @default(cuid())
  keyId               String             @unique // Public correlation handle: key_live_01j7x4
  name                String
  environmentId       String
  keyType             String             @default("PROJECT_SCOPED") // PLATFORM_ROOT, PROJECT_SCOPED, SERVICE_MACHINE
  keyPrefix           String             // orb_live_proj_
  secretFingerprint   String             // SHA-256(rawSecret).hex (display only)
  authVerifier        String             // HMAC-SHA-256(pepper, rawSecret).hex (auth check)
  verifierPepperId    String?            // Active pepper ID at key creation (for rotation tracking)
  maskedDisplay       String             // orb_live_••••••••0zE
  status              KeyLifecycleState  @default(ACTIVE)
  capabilities        String[]           // Typed: ["restaurant.orders.read", "restaurant.orders.create"]
  ipAllowlist         String[]           @default([])
  rateLimitPerMin     Int                @default(1200)
  tenantScope         String[]           @default([])
  
  riskScore           Int                @default(15) // 0 to 100
  riskLevel           PlatformRiskLevel  @default(LOW)
  riskFactors         Json               @default("[]") // Array of { code, weight, message }

  issuedAt            DateTime           @default(now())
  activatedAt         DateTime           @default(now())
  expiresAt           DateTime?
  lastUsedAt          DateTime?
  lastUsedIp          String?
  lastUsedRegion      String?
  
  compromisedAt       DateTime?
  revokedAt           DateTime?
  revokeReason        String?
  createdBy           String
  version             Int                @default(1)

  environment         ProjectEnvironment @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId])
  @@unique([authVerifier])
  @@index([secretFingerprint])
  @@index([status])
  @@index([riskLevel])
}

model PlatformCredential {
  id                    String                @id @default(cuid())
  name                  String                // "Stripe Production Live", "AWS S3 Cold Storage"
  provider              String                // stripe, aws_s3, meta, twilio, redis, postgres
  environmentId         String
  
  // Envelope Encryption Fields
  envelopeVersion       Int                   @default(1)
  kekIdentifier         String                // kms:us-east-1:orbitox-master-kek-v2
  encryptedDek          String                // Encrypted Data Encryption Key (DEK)
  dekIv                 String                @default("") // Base64 IV used for DEK encryption
  dekTag                String                @default("") // Base64 AuthTag for DEK encryption
  initializationVector  String                // 96-bit Base64 IV
  authenticationTag     String                // 128-bit Base64 GCM Auth Tag
  encryptedCiphertext   String                // AES-256-GCM Encrypted Secret Payload
  
  secretFingerprint     String                // SHA-256(plaintext).hex
  maskedDisplay         String                // sk_live_••••••••9F2A
  health                CredentialHealthState @default(HEALTHY)
  lastRotatedAt         DateTime              @default(now())
  nextRotationDueAt     DateTime
  lastValidatedAt       DateTime?
  validationError       String?
  ownerEmail            String
  
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  environment           ProjectEnvironment    @relation(fields: [environmentId], references: [id], onDelete: Cascade)

  @@index([environmentId])
  @@index([provider])
  @@index([health])
}

model PlatformPackage {
