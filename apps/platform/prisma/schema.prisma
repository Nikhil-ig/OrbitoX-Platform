// OrbitoX Platform OS - Multi-Tenant E-Commerce Prisma Schema
// Database Engine: PostgreSQL 16
// Multi-Tenancy Architecture: Context / Tenant ID Partitioning

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 4. RESTAURANT OPERATING SYSTEM (RESTAURANTOS)
// ─────────────────────────────────────────────────────────────

enum RestaurantTableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE
}

enum DiningSessionStatus {
  ACTIVE
  BILL_REQUESTED
  SETTLING
  CLOSED
  ABANDONED
}

enum DiningJoinPolicy {
  OPEN_JOIN
  HOST_APPROVAL
  STAFF_APPROVAL
}

enum ParticipantRole {
  HOST
  GUEST
  STAFF
}

enum JoinRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum CommercialState {
  DRAFT
  SUBMITTED
  CONFIRMED
  REJECTED
  VOIDED
}

enum FulfillmentState {
  UNFULFILLED
  PREPARING
  READY_TO_SERVE
  SERVED
  CANCELLED
}

enum OrderPaymentState {
  UNPAID
  AUTHORIZED
  PARTIALLY_PAID
  PAID
  REFUNDED
}

enum KitchenState {
  NOT_SENT
  QUEUED
  IN_PROGRESS
  EXPEDITED
  COMPLETED
}

enum ItemPrepStatus {
  PENDING
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum KitchenStationType {
  HOT_LINE
  COLD_LINE
  TANDOOR
  BAR
  DESSERT
  EXPO
}

enum PreparationTaskStatus {
  QUEUED
  IN_PROGRESS
  READY
  DELAYED
  REOPENED
  BUMPED
}

enum PaymentRecordStatus {
  INITIATED
  AUTHORIZED
  SETTLED
  FAILED
  REFUNDED
}

enum OutboxStatus {
  PENDING
  DISPATCHED
  FAILED
}

model RestaurantLocation {
  id              String                  @id @default(cuid())
  tenantId        String
  companyId       String
  name            String
  slug            String
  timezone        String                  @default("Asia/Kolkata")
  currency        String                  @default("INR")
  address         String?
  phone           String?
  email           String?
  operatingHours  Json?
  isActive        Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  serviceAreas    RestaurantServiceArea[]
  tables          RestaurantTable[]
  diningSessions  RestaurantDiningSession[]
  menus           RestaurantMenu[]
  catalogItems    RestaurantCatalogItem[]
  kitchenStations KitchenStation[]
  orders          RestaurantOrder[]

  @@unique([tenantId, companyId, slug])
  @@index([tenantId, companyId])
}

model RestaurantServiceArea {
  id          String             @id @default(cuid())
  tenantId    String
  companyId   String
  locationId  String
  name        String
  code        String
  floorNumber Int?               @default(1)
  capacity    Int?
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  location    RestaurantLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tables      RestaurantTable[]

  @@unique([locationId, code])
  @@index([tenantId, companyId])
  @@index([locationId])
}

model RestaurantTable {
  id              String                    @id @default(cuid())
  tenantId        String
  companyId       String
  locationId      String
  serviceAreaId   String
  tableNumber     String
  capacity        Int                       @default(4)
  status          RestaurantTableStatus     @default(AVAILABLE)
  activeSessionId String?
  version         Int                       @default(1)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  location        RestaurantLocation        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  serviceArea     RestaurantServiceArea     @relation(fields: [serviceAreaId], references: [id], onDelete: Cascade)
  qrIdentity      RestaurantQRIdentity?
  diningSessions  RestaurantDiningSession[]

  @@unique([locationId, tableNumber])
  @@index([tenantId, companyId])
  @@index([locationId, serviceAreaId])
  @@index([status])
}

model RestaurantQRIdentity {
  id              String          @id @default(cuid())
  tenantId        String
  companyId       String
  locationId      String
  tableId         String          @unique
  locator         String          @unique
  tokenHash       String          @unique
  redirectUrl     String?
  securityVersion Int             @default(1)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  table           RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tenantId, locationId])
  @@index([locator])
  @@index([tokenHash])
}

model RestaurantDiningSession {
  id                String                  @id @default(cuid())
  tenantId          String
  companyId         String
  locationId        String
  tableId           String
  sessionCode       String
  status            DiningSessionStatus     @default(ACTIVE)
  joinPolicy        DiningJoinPolicy        @default(OPEN_JOIN)
  hostParticipantId String?
  accessEpoch       Int                     @default(1)
  version           Int                     @default(1)
  openedAt          DateTime                @default(now())
  closedAt          DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  location          RestaurantLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  table             RestaurantTable         @relation(fields: [tableId], references: [id], onDelete: Cascade)
  participants      SessionParticipant[]
  joinRequests      SessionJoinRequest[]
  orders            RestaurantOrder[]

  @@index([tenantId, companyId])
  @@index([locationId, tableId])
  @@index([tableId, status])
  @@index([status])
}

model SessionParticipant {
  id                  String                  @id @default(cuid())
  tenantId            String
  companyId           String
  locationId          String
  diningSessionId     String
  role                ParticipantRole         @default(GUEST)
  displayName         String
  avatarUrl           String?
  capabilityTokenHash String
  joinedAt            DateTime                @default(now())
  leftAt              DateTime?
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  diningSession       RestaurantDiningSession @relation(fields: [diningSessionId], references: [id], onDelete: Cascade)
  orders              RestaurantOrder[]

  @@index([tenantId, locationId])
  @@index([diningSessionId, isActive])
  @@index([capabilityTokenHash])
}

model SessionJoinRequest {
  id               String                  @id @default(cuid())
  tenantId         String
  companyId        String
  locationId       String
  diningSessionId  String
  displayName      String
  status           JoinRequestStatus       @default(REQUESTED)
  requestTokenHash String                  @unique
  decidedBy        String?
  decidedAt        DateTime?
  expiresAt        DateTime
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  diningSession    RestaurantDiningSession @relation(fields: [diningSessionId], references: [id], onDelete: Cascade)

  @@index([diningSessionId, status])
  @@index([tenantId, locationId])
}

model RestaurantMenu {
  id          String                  @id @default(cuid())
  tenantId    String
  companyId   String
  locationId  String
  name        String
  version     Int                     @default(1)
  channel     String                  @default("DINE_IN")
  isPublished Boolean                 @default(false)
  schedule    Json?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  location    RestaurantLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  items       RestaurantCatalogItem[]

  @@unique([locationId, name, version])
  @@index([tenantId, locationId, isPublished])
}

model RestaurantCatalogItem {
  id                         String                    @id @default(cuid())
  tenantId                   String
  companyId                  String
  locationId                 String
  menuId                     String?
  name                       String
  description                String?
  sku                        String?
  basePriceMinor             BigInt
  currency                   String                    @default("INR")
  category                   String
  imageUrl                   String?
  allergens                  String[]                  @default([])
  dietaryFlags               String[]                  @default([])
  isAvailable                Boolean                   @default(true)
  maxDailyQuantity           Int?
  preparationDurationMinutes Int                       @default(10)
  stationRouting             String                    @default("KITCHEN")
  version                    Int                       @default(1)
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt

  location                   RestaurantLocation        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  menu                       RestaurantMenu?           @relation(fields: [menuId], references: [id], onDelete: SetNull)
  modifierGroups             RestaurantModifierGroup[]
  orderItems                 RestaurantOrderItem[]

  @@index([tenantId, locationId, category])
  @@index([locationId, isAvailable])
  @@index([menuId])
}

model RestaurantModifierGroup {
  id            String                @id @default(cuid())
  tenantId      String
  companyId     String
  itemId        String
  name          String
  minSelections Int                   @default(0)
  maxSelections Int                   @default(1)
  isRequired    Boolean               @default(false)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  item          RestaurantCatalogItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  modifiers     RestaurantModifier[]

  @@index([itemId])
}

model RestaurantModifier {
  id              String                  @id @default(cuid())
  tenantId        String
  companyId       String
  groupId         String
  name            String
  priceDeltaMinor BigInt                  @default(0)
  isDefault       Boolean                 @default(false)
  isAvailable     Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  group           RestaurantModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

model RestaurantRecipeBOM {
  id               String   @id @default(cuid())
  tenantId         String
  companyId        String
  itemId           String
  ingredientId     String
  quantityRequired Float
  unit             String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([itemId, ingredientId])
  @@index([tenantId, companyId])
  @@index([ingredientId])
}

model RestaurantInventoryStock {
  id               String   @id @default(cuid())
  tenantId         String
  companyId        String
  locationId       String
  ingredientId     String
  name             String
  onHandQuantity   Float
  reservedQuantity Float    @default(0)
  unit             String
  safetyThreshold  Float    @default(5.0)
  version          Int      @default(1)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([locationId, ingredientId])
  @@index([tenantId, locationId])
}

model RestaurantPricingQuote {
  id              String   @id @default(cuid())
  tenantId        String
  companyId       String
  locationId      String
  sessionId       String
  inputHash       String
  resultHash      String
  subtotalMinor   BigInt
  taxMinor        BigInt
  serviceFeeMinor BigInt   @default(0)
  discountMinor   BigInt   @default(0)
  totalMinor      BigInt
  currency        String   @default("INR")
  breakdown       Json
  expiresAt       DateTime
  isRedeemed      Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([tenantId, sessionId])
  @@index([inputHash, resultHash])
  @@index([expiresAt, isRedeemed])
}

model RestaurantOrder {
  id                  String                  @id @default(cuid())
  tenantId            String
  companyId           String
  locationId          String
  sessionId           String
  participantId       String
  orderNumber         String
  commercialState     CommercialState         @default(SUBMITTED)
  fulfillmentState    FulfillmentState        @default(UNFULFILLED)
  paymentState        OrderPaymentState       @default(UNPAID)
  kitchenState        KitchenState            @default(QUEUED)
  quoteId             String?
  idempotencyKey      String?                 @unique
  totalMinor          BigInt
  currency            String                  @default("INR")
  specialInstructions String?
  version             Int                     @default(1)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  location            RestaurantLocation      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  diningSession       RestaurantDiningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  participant         SessionParticipant      @relation(fields: [participantId], references: [id], onDelete: Cascade)
  items               RestaurantOrderItem[]

  @@index([tenantId, companyId])
  @@index([locationId, sessionId])
  @@index([sessionId, createdAt])
  @@index([commercialState, fulfillmentState])
}

model RestaurantOrderItem {
  id                String                @id @default(cuid())
  tenantId          String
  companyId         String
  locationId        String
  orderId           String
  itemId            String
  name              String
  quantity          Int                   @default(1)
  unitPriceMinor    BigInt
  totalMinor        BigInt
  selectedModifiers Json                  @default("[]")
  preparationStatus ItemPrepStatus        @default(PENDING)
  version           Int                   @default(1)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  order             RestaurantOrder       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  catalogItem       RestaurantCatalogItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([orderId, preparationStatus])
  @@index([itemId])
}

model KitchenStation {
  id                    String                   @id @default(cuid())
  tenantId              String
  companyId             String
  locationId            String
  name                  String
  stationType           KitchenStationType       @default(HOT_LINE)
  displayOrder          Int                      @default(0)
  isActive              Boolean                  @default(true)
  maxConcurrentCapacity Int                      @default(10)
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  location              RestaurantLocation       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  tasks                 KitchenPreparationTask[]

  @@unique([locationId, name])
  @@index([tenantId, locationId, isActive])
}

model KitchenPreparationTask {
  id                       String                @id @default(cuid())
  tenantId                 String
  companyId                String
  locationId               String
  orderId                  String
  orderItemId              String
  stationId                String
  status                   PreparationTaskStatus @default(QUEUED)
  targetServeAt            DateTime
  fireAt                   DateTime
  estimatedDurationMinutes Int                   @default(10)
  startedAt                DateTime?
  completedAt              DateTime?
  bumpedBy                 String?
  dependencies             Json?
  version                  Int                   @default(1)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt

  station                  KitchenStation        @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@index([stationId, status, fireAt])
  @@index([orderId])
  @@index([tenantId, locationId])
}

model RestaurantPaymentRecord {
  id                   String              @id @default(cuid())
  tenantId             String
  companyId            String
  locationId           String
  sessionId            String
  orderId              String?
  participantId        String?
  paymentGateway       String
  gatewayTransactionId String?
  amountMinor          BigInt
  currency             String              @default("INR")
  status               PaymentRecordStatus @default(INITIATED)
  metadata             Json?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([tenantId, locationId])
  @@index([sessionId, status])
  @@index([gatewayTransactionId])
}

model PlatformIdempotencyRecord {
  id             String   @id @default(cuid())
  tenantId       String
  key            String
  scope          String
  requestHash    String
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([tenantId, key, scope])
  @@index([expiresAt])
}

model PlatformOutboxMessage {
  id            String       @id @default(cuid())
  tenantId      String
  eventType     String
  aggregateType String
  aggregateId   String
  payload       Json
  status        OutboxStatus @default(PENDING)
  retryCount    Int          @default(0)
  lastError     String?
  createdAt     DateTime     @default(now())
  dispatchedAt  DateTime?

  @@index([status, createdAt])
  @@index([tenantId, aggregateType, aggregateId])
}

// ─────────────────────────────────────────────────────────────
// 10. PLATFORM CONTROL CENTER: MULTI-TENANT OS & SECURITY GOVERNANCE
// ─────────────────────────────────────────────────────────────

enum PlatformProjectStatus {
  PROVISIONING
  ACTIVE
  DEGRADED
  THROTTLED
  SUSPENDED
  ARCHIVED
  DEPROVISIONING
}

enum PlatformOperatorRole {
  PLATFORM_OWNER
  OPERATOR
  SUPPORT_READONLY
  BILLING
}

enum CustomerMembershipRole {
  OWNER
  ADMIN
  MEMBER
  BILLING
}

enum AccountTokenPurpose {
  VERIFY_EMAIL
  RESET_PASSWORD
  INVITE
  EMAIL_CHANGE
}

enum EnvironmentTier {
  DEVELOPMENT
  STAGING
  PRODUCTION
  SANDBOX
  DISASTER_RECOVERY
}

enum KeyLifecycleState {
  PRE_ACTIVE
  ACTIVE
  SUSPENDED
  EXPIRED
  COMPROMISED
  REVOKED
  DESTROYED
}

enum PlatformRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum CredentialHealthState {
  HEALTHY
  EXPIRING_SOON
  EXPIRED
  FAILED_VALIDATION
  ROTATION_PENDING
}

enum PackageStatusState {
  ACTIVE
  UPGRADING
  SUSPENDED
  SECURITY_BLOCKED
}

enum DomainDnsStatus {
  PENDING_DNS
  VERIFIED
  FAILED
}

enum TlsCertStatus {
  PENDING
  ISSUED
  RENEWING
  FAILED
}

model PlatformOrganization {
  id              String            @id @default(cuid())
  slug            String            @unique
  name            String
  billingEmail    String
  complianceTier  String            @default("STANDARD")
  status          String            @default("ACTIVE")
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  projects        PlatformProject[]
  customerMemberships CustomerMembership[]
  accountTokens   AccountToken[]

  @@index([slug])
}

model CustomerOrganizationClosureContext {
  transactionId  BigInt @db.BigInt
  organizationId String @db.Text

  @@id([transactionId, organizationId])
}

model PlatformOperator {
  id                    String               @id @default(cuid())
  email                 String
  passwordHash          String
  role                  PlatformOperatorRole
  status                String               @default("ACTIVE")
  mfaTotpSealed         String
  failedLogins          Int                  @default(0)
  failureWindowStartedAt DateTime?            @db.Timestamptz
  lockedUntil           DateTime?             @db.Timestamptz
  lastTotpStep          Int?
  appearanceTheme            String               @default("dark")
  appearanceAccent           String               @default("ocean")
  appearanceDensity          String               @default("standard")
  appearanceRadius           Int                  @default(28)
  appearanceSmoothAnimations Boolean              @default(true)
  appearanceBoldFocusRings   Boolean              @default(false)
  appearanceCompactSidebar   Boolean              @default(false)
  createdAt             DateTime              @default(now()) @db.Timestamptz
  updatedAt             DateTime              @default(now()) @updatedAt @db.Timestamptz

  sessions              PlatformOperatorSession[]
  backupCodes           PlatformOperatorBackupCode[]

  @@index([status])
}

model PlatformOperatorSession {
  id                String    @id @default(cuid())
  operatorId        String
  tokenHash         String    @unique
  csrfTokenHash     String
  createdAt         DateTime  @default(now()) @db.Timestamptz
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz
  idleExpiresAt     DateTime  @db.Timestamptz
  absoluteExpiresAt DateTime  @db.Timestamptz
  reauthenticatedAt DateTime? @db.Timestamptz
  revokedAt         DateTime? @db.Timestamptz
  ipAddress         String?
  userAgent         String?

  operator PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([operatorId, revokedAt])
  @@index([idleExpiresAt])
}

model PlatformOperatorBackupCode {
  operatorId String    @db.Text
  codeHash   String    @db.Text
  createdAt  DateTime  @default(now()) @db.Timestamptz
  usedAt     DateTime? @db.Timestamptz

  operator PlatformOperator @relation(fields: [operatorId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([operatorId, codeHash])
  @@index([operatorId, usedAt])
}

model CustomerUser {
  id                    String    @id @default(cuid())
  email                 String
  emailVerifiedAt       DateTime? @db.Timestamptz
  passwordHash          String?
  mfaTotpSealed         String?
  mfaTotpPendingSealed  String?
  status                String    @default("ACTIVE")
  failedLogins          Int       @default(0)
  failureWindowStartedAt DateTime? @db.Timestamptz
  lockedUntil           DateTime? @db.Timestamptz
  lastTotpStep          Int?
  appearanceTheme            String               @default("light")
  appearanceAccent           String               @default("ocean")
  appearanceDensity          String               @default("standard")
  appearanceRadius           Int                  @default(28)
  appearanceSmoothAnimations Boolean              @default(true)
  appearanceBoldFocusRings   Boolean              @default(false)
  appearanceCompactSidebar   Boolean              @default(false)
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @db.Timestamptz

  memberships CustomerMembership[]
  tokens      AccountToken[]
  sessions    CustomerSession[]

  @@index([status])
}

model CustomerMembership {
  organizationId String                 @db.Text
  userId         String                 @db.Text
  role           CustomerMembershipRole
  createdAt      DateTime               @default(now()) @db.Timestamptz

  organization PlatformOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user         CustomerUser         @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([organizationId, userId])
  @@index([userId, role])
}

// Migration 20261103000000 creates the partial index AccountToken_user_purpose
// on ("userId", "purpose") WHERE "usedAt" IS NULL; Prisma cannot describe it.
// Reject any generated migration that drops this index.
model AccountToken {
  tokenHash      String            @id
  purpose        AccountTokenPurpose
  userId         String?
  organizationId String?
  email          String
  role           CustomerMembershipRole?
  expiresAt      DateTime          @db.Timestamptz
  usedAt         DateTime?         @db.Timestamptz
  createdAt      DateTime          @default(now()) @db.Timestamptz

  user         CustomerUser? @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization PlatformOrganization? @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([expiresAt])
}

model CustomerSession {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique
  csrfTokenHash     String
  createdAt         DateTime  @default(now()) @db.Timestamptz
  lastSeenAt        DateTime  @default(now()) @db.Timestamptz
  idleExpiresAt     DateTime  @db.Timestamptz
  absoluteExpiresAt DateTime  @db.Timestamptz
  reauthenticatedAt DateTime? @db.Timestamptz
  revokedAt         DateTime? @db.Timestamptz
  ipAddress         String?
  userAgent         String?

  user CustomerUser @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, revokedAt])
  @@index([idleExpiresAt])
}

model AccountAuthRateLimitBucket {
  scopeType    String
  scopeId      String
  windowStart  DateTime @db.Timestamptz
  requestCount Int      @default(0)
  expiresAt    DateTime @db.Timestamptz

  @@id([scopeType, scopeId, windowStart])
  @@index([expiresAt])
}

model AccountEmailOutbox {
  id              String    @id @default(cuid())
  recipient       String
  template        String
  encryptedPayload String
  status          String    @default("PENDING")
  retryCount      Int       @default(0)
  lastError       String?
  createdAt       DateTime  @default(now()) @db.Timestamptz
  dispatchedAt    DateTime? @db.Timestamptz
  claimedAt       DateTime? @db.Timestamptz
  claimToken      String?
  nextAttemptAt   DateTime  @default(now()) @db.Timestamptz

  @@index([status, createdAt])
}

model AccountEmailSuppression {
  email       String   @id
  reason      String
  provider    String
  suppressedAt DateTime @default(now()) @db.Timestamptz
}

model AccountEmailWebhookEvent {
  eventId    String   @id
  provider   String
  eventType  String
  receivedAt DateTime @default(now()) @db.Timestamptz
}

model BillingGraceSweepLease {
  id            String   @id @default("global")
  leaseOwner    String
  leaseExpiresAt DateTime @db.Timestamptz
  updatedAt     DateTime @default(now()) @db.Timestamptz
}

model DataRightsJob {
  id                String    @id
  kind              String
  status            String    @default("QUEUED")
  organizationId    String?
  requestedByUserId String
  leaseOwner        String?
  leaseExpiresAt    DateTime? @db.Timestamptz
  attempts          Int       @default(0)
  maxAttempts       Int       @default(5)
  checkpoint        Json      @default("{}")
  result            Json?
