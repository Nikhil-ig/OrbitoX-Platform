  "templates": [
    {
      "id": "tmpl_haute_gastronomy",
      "slug": "haute-gastronomy",
      "name": "Haute Gastronomy Noir",
      "category": "Haute Gastronomy",
      "description": "Ultra-luxurious dark canvas with champagne gold accents, dramatic editorial dish photography, and bespoke tasting menu typography.",
      "tagline": "Michelin-grade restraint, rich storytelling & sommelier pairings",
      "version": "2.4.0",
      "author": "OrbitoX Creative Labs",
      "tierRequired": "pro",
      "priceLabel": "Included in Pro",
      "accentColor": "#C86B3C",
      "fontHeading": "\"Playfair Display\", Georgia, serif",
      "fontBody": "system-ui, -apple-system, sans-serif",
      "previewThumbnail": "https://images.unsplash.com/photo-1544025162-d76694265947?w=600&auto=format&fit=crop&q=80",
      "previewHero": "https://images.unsplash.com/photo-1544025162-d76694265947?w=1600&auto=format&fit=crop&q=85",
      "supportedComponents": [
        "editorial_cards",
        "tasting_timeline",
        "pairing_sheet",
        "sommelier_notes",
        "chef_manifesto"
      ],
      "composition": {
        "pageArchitecture": "editorial-tasting-split",
        "heroArchitecture": "split-asymmetric",
        "menuLayoutPattern": "course-progression-timeline",
        "cardComposition": "editorial-sommelier",
        "navigationPattern": "story-anchor-strip",
        "cartPresentation": "sommelier-drawer",
        "responsiveRules": {
          "desktopColumns": 2,
          "tabletColumns": 1,
          "mobileColumns": 1,
          "layoutBehavior": "asymmetric-split-with-course-timeline"
        },
        "componentTree": [
          {
            "id": "haute-hero",
            "type": "HeroSplitAsymmetric",
            "name": "Editorial Asymmetric Hero",
            "layout": "split-asymmetric",
            "props": {
              "showManifesto": true,
              "elevation": "inset"
            }
          },
          {
            "id": "haute-story",
            "type": "ChefManifestoSection",
            "name": "Brass Handi & Hearth Philosophy",
            "layout": "editorial-timeline",
            "props": {
              "quoteAuthor": "Executive Chef",
              "quoteRole": "Curator"
            }
          },
          {
            "id": "haute-tasting",
            "type": "TastingCourseTimeline",
            "name": "Four-Course Tasting Progression",
            "layout": "editorial-timeline",
            "props": {
              "courses": [
                "Amuse & Crudo",
                "Charcoal Hearth",
                "Heritage Mains",
                "Grand Finale"
              ]
            },
            "children": [
              {
                "id": "haute-course-1",
                "type": "CourseGroup",
                "name": "Course I: Amuse & Starters",
                "layout": "dense-stack",
                "props": {
                  "winePairing": "Champagne Brut Nature"
                }
              },
              {
                "id": "haute-course-2",
                "type": "CourseGroup",
                "name": "Course II: Charcoal Tandoor",
                "layout": "dense-stack",
                "props": {
                  "winePairing": "Pinot Noir 2021"
                }
              },
              {
                "id": "haute-course-3",
                "type": "CourseGroup",
                "name": "Course III: Imperial Curries",
                "layout": "dense-stack",
                "props": {
                  "winePairing": "Syrah Reserve"
                }
              },
              {
                "id": "haute-course-4",
                "type": "CourseGroup",
                "name": "Course IV: Desserts & Elixirs",
                "layout": "dense-stack",
                "props": {
                  "winePairing": "Tawny Port 10yr"
                }
              }
            ]
          },
          {
            "id": "haute-cellar",
            "type": "SommelierPairingDrawer",
            "name": "Sommelier Cellar Notes",
            "layout": "flex-col",
            "props": {
              "defaultExpanded": false
            }
          }
        ]
      },
      "defaultTokens": {
        "primaryColor": "#C86B3C",
        "secondaryColor": "#D99A45",
        "backgroundColor": "#090B0E",
        "surfaceColor": "#121519",
        "textColor": "#F3EEE5",
        "mutedColor": "#8C857B",
        "fontFamilyHeading": "\"Playfair Display\", serif",
        "fontFamilyBody": "system-ui, sans-serif",
        "borderRadius": "8px",
        "cardStyle": "tactile",
        "heroHeight": "480px"
      },
      "defaultSections": [
        {
          "id": "sec_hero_noir",
          "type": "hero",
          "title": "Culinary Precision & Heritage Charcoal",
          "subtitle": "Slow-fired embers, brass vessels, and progressive pan-Indian gastronomy in an intimate noir courtyard.",
          "imageUrl": "https://images.unsplash.com/photo-1544025162-d76694265947?w=1200&auto=format&fit=crop&q=80",
          "ctaText": "Explore Evening Menu",
          "ctaLink": "#menu",
          "visible": true,
          "order": 1
        },
        {
