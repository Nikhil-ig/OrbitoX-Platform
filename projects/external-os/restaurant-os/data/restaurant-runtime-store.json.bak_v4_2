              },
              {
                "id": "haute-course-3",
                "type": "CourseGroup",
                "name": "Movement III: Royal Curries",
                "layout": "dense-stack",
                "props": {
                  "winePairing": "2018 Domaine Barolo Riserva"
                }
              },
              {
                "id": "haute-course-4",
                "type": "CourseGroup",
                "name": "Movement IV: Desserts & Elixirs",
                "layout": "dense-stack",
                "props": {
                  "winePairing": "Tawny Port 20-Year Aged"
                }
              }
            ]
          },
          {
            "id": "haute-cellar",
