# 🪐 RestaurantOS Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Server & Network
PORT=4010
NODE_ENV=production
HOST=0.0.0.0

# Multi-Tenant PostgreSQL Connection
DATABASE_URL=postgresql://restaurantos:restaurantos_pilot_secret@localhost:5432/restaurant_os?schema=public

# Statutory Indian GST Compliance (SAC 996331)
RESTAURANT_GSTIN=27AAPFU0939F1ZV

# Razorpay Payment Gateway Integration
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=yyyyyyyyyyyyyyyyyyyyyyyy
RAZORPAY_WEBHOOK_SECRET=zzzzzzzzzzzzzzzzzzzzzzzz
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Security & Staff PIN Signing Secret (Must be 32+ characters)
STAFF_AUTH_SECRET=generate_with_openssl_rand_hex_32_chars_min

# OrbitoX Control Plane Registration & Fleet Telemetry
ORBITOX_CONTROL_PLANE_URL=http://localhost:3005
ORBITOX_RUNTIME_TOKEN=pilot_runtime_token_here
ORBITOX_PROJECT_ID=restaurant-os-pilot

# Tenancy Scoping
DEFAULT_TENANT_ID=tenant_pilot_bistro
