# ===========================================
# RestaurantOS Runtime — Environment Variables
# ===========================================
# Copy to .env.local; NEVER commit actual secrets.
# ===========================================

NODE_ENV=development
PORT=4010
ALLOW_DEV_SECRETS=

# Staff authentication signing secret (minimum 32 characters)
# Generation hint: openssl rand -base64 48
STAFF_SIGNING_SECRET=

# Guest dining session signing secret
# Generation hint: openssl rand -base64 48
ORBITOX_GUEST_SECRET=

# Hardware kitchen station secrets configuration
# JSON string e.g. {"sec_rot_prod_9918":{"station":"TANDOOR","branchId":"branch_ldh","isPrivileged":false}}
RESTAURANT_STATION_SECRETS=

# Cross-Origin Resource Sharing allowlist (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4010

# Test & maintenance routes gate
ENABLE_TEST_ROUTES=0
