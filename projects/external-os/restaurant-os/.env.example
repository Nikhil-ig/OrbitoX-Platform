# 🪐 RestaurantOS Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────

# Server & Network
PORT=4010
NODE_ENV=production
HOST=0.0.0.0

# Multi-Tenant PostgreSQL Connection (Non-superuser application role with NOSUPERUSER NOBYPASSRLS)
DATABASE_URL=postgresql://restaurantos_app:CHANGE_ME_APP_PASSWORD@localhost:5432/restaurant_os?schema=public

# Database Migration & Administrative Connection (Used only by prisma migrate deploy)
MIGRATION_DATABASE_URL=postgresql://restaurantos_admin:CHANGE_ME_ADMIN_PASSWORD@localhost:5432/restaurant_os?schema=public

# Database Application Role Password (Used during initial role setup)
APP_DB_PASSWORD=CHANGE_ME_APP_PASSWORD

# Statutory Indian GST Compliance (SAC 996331)
RESTAURANT_GSTIN=27AAPFU0939F1ZV

# Razorpay Payment Gateway Integration (Fleet default; individual tenants configure via UI)
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME_RAZORPAY_SECRET
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME_WEBHOOK_SECRET
RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# Security & Staff PIN Signing Secret (Cryptographically random, minimum 32 characters)
STAFF_AUTH_SECRET=CHANGE_ME_STAFF_AUTH_SECRET_MIN_32_CHARS_GENERATE_WITH_OPENSSL

# OrbitoX Control Plane Platform Token
RESTAURANTOS_PLATFORM_TOKEN=CHANGE_ME_PLATFORM_TOKEN_32_CHARS_MIN

# OrbitoX Control Plane Registration & Fleet Telemetry
ORBITOX_CONTROL_PLANE_URL=http://localhost:3005
ORBITOX_RUNTIME_TOKEN=CHANGE_ME_RUNTIME_TOKEN
ORBITOX_PROJECT_ID=restaurant-os-fleet
