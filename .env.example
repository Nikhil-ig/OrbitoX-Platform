# ===========================================
# OrbitoX Platform — Master Environment Variables
# ===========================================
# Copy this file to .env.local and fill in values.
# NEVER commit .env or .env.local to version control.
# Secrets must NEVER be in code or committed env files.
# ===========================================

# --- Application & Development ---
NODE_ENV=development
PORT=3000
# Set to '1' ONLY when NODE_ENV is 'development' to generate ephemeral in-memory secrets
ALLOW_DEV_SECRETS=

# --- Cryptographic Platform Secrets ---
# Generation hint: openssl rand -base64 48
ORBITOX_CONTROL_PLANE_SECRET=
ORBITOX_GUEST_SECRET=
ORBITOX_API_KEY_PEPPER=
ORBITOX_SNAPSHOT_SECRET=
ENCRYPTION_KEY=

# --- Authentication & Signing ---
# RSA 2048/4096 or Ed25519 keys; hint: openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY=
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# --- RestaurantOS & Staff Auth ---
# Generation hint: openssl rand -base64 48
STAFF_SIGNING_SECRET=
# Station mapping JSON or comma-separated pairs: secret:station:branchId:isPrivileged
RESTAURANT_STATION_SECRETS=

# --- Database & Cache ---
DATABASE_URL=
REDIS_URL=

# --- Storage (AWS S3) ---
AWS_REGION=us-east-1
S3_BUCKET_NAME=orbitox-storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Third-Party Integrations ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
